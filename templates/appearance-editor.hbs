<div class="dicer-ae-body">
  <div class="dicer-ae-main">
    <aside class="dicer-ae-preview">
      <div class="dicer-stage dicer-ae-stage" style="--dicer-swatch: {{form.body.color}}">
        <i class="dicer-fallback fa-solid fa-dice-d20" aria-hidden="true"></i>
        <canvas class="dicer-live" role="img" aria-label="{{localize "DICER.Appearance.Preview"}}" hidden></canvas>
        {{#if isOverride}}<span class="dicer-ae-stage-tag">{{editingType}}</span>{{/if}}
      </div>
      <nav class="dicer-segmented dicer-ae-dice" aria-label="{{localize "DICER.Appearance.DieType"}}">
        {{#each dice}}
          <button type="button" class="{{#if active}}active{{/if}} {{#if overridden}}has-own{{/if}}" data-action="previewDie" data-type="{{type}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}"{{#if overridden}} data-tooltip="DICER.Appearance.PerType.HasOwn"{{/if}}>{{type}}</button>
        {{/each}}
      </nav>
      <button type="button" class="dicer-ae-throw" data-action="throwLook" data-tooltip="DICER.Appearance.ThrowHint"><i class="fa-solid fa-dice"></i> {{localize "DICER.Appearance.Throw"}}</button>
      <p class="dicer-hint dicer-ae-drag">{{#if hasPreview}}<i class="fa-solid fa-hand-pointer"></i> {{localize "DICER.Appearance.DragHint"}}{{else}}{{localize "DICER.Appearance.PreviewUnavailable"}}{{/if}}</p>
      <div class="dicer-ae-tools" role="group" aria-labelledby="dicer-ae-tools-h">
        <h4 id="dicer-ae-tools-h">{{localize "DICER.Appearance.LookTools"}}</h4>
        <button type="button" data-action="copyLook" data-tooltip="DICER.Appearance.CopyLook"><i class="fa-solid fa-copy"></i> {{localize "DICER.Appearance.Tools.Copy"}}</button>
        <button type="button" data-action="pasteLook" data-tooltip="DICER.Appearance.PasteLook"><i class="fa-solid fa-paste"></i> {{localize "DICER.Appearance.Tools.Paste"}}</button>
        <button type="button" data-action="exportLook" data-tooltip="DICER.Appearance.ExportLook"><i class="fa-solid fa-file-export"></i> {{localize "DICER.Appearance.Tools.Export"}}</button>
        <button type="button" data-action="importLook" data-tooltip="DICER.Appearance.ImportLook"><i class="fa-solid fa-file-import"></i> {{localize "DICER.Appearance.Tools.Import"}}</button>
        <input type="file" class="dicer-ae-file" accept=".json,application/json" hidden>
      </div>
    </aside>

    <div class="dicer-ae-layers">
      {{#if isOverride}}
        <div class="dicer-ae-banner">
          <i class="fa-solid fa-dice"></i>
          <span>{{editingLabel}}</span>
          <button type="button" class="dicer-ghost" data-action="editType" data-type="default"><i class="fa-solid fa-arrow-left"></i> {{localize "DICER.Appearance.PerType.BackToDefault"}}</button>
        </div>
      {{/if}}

      <details class="dicer-ae-section" data-section="body" {{#if open.body}}open{{/if}}>
        <summary><i class="fa-solid fa-cube"></i> <span>{{localize "DICER.Appearance.Section.body"}}</span><em>{{summary.body}}</em></summary>
        <div class="dicer-ae-fields">
          <div class="dicer-field">
            <span>{{localize "DICER.Appearance.Body.Type"}}</span>
            <div class="dicer-ae-chips" role="radiogroup" aria-label="{{localize "DICER.Appearance.Body.Type"}}">
              {{#each bodyTypes}}
                <button type="button" class="dicer-ae-chip {{#if active}}active{{/if}}" role="radio" aria-checked="{{#if active}}true{{else}}false{{/if}}" data-action="setField" data-field="body.type" data-value="{{id}}">
                  <span class="dicer-ae-swatch dicer-ae-swatch-{{id}}" style="--c: {{../form.body.color}}; --c2: {{../form.body.color2}}" aria-hidden="true"></span>
                  <span>{{label}}</span>
                </button>
              {{/each}}
            </div>
          </div>
          <div class="dicer-ae-row">
            <div class="dicer-field dicer-ae-color"><span>{{localize "DICER.Appearance.Body.Color"}}</span><span class="dicer-ae-color-pair"><input type="color" value="{{form.body.color}}" data-color-for="body.color" aria-label="{{localize "DICER.Appearance.Body.Color"}}"><input type="text" name="body.color" value="{{form.body.color}}" maxlength="7" spellcheck="false" aria-label="{{localize "DICER.Appearance.Body.Color"}}"></span></div>
            {{#if show.color2}}<div class="dicer-field dicer-ae-color"><span>{{localize "DICER.Appearance.Body.SecondColor"}}</span><span class="dicer-ae-color-pair"><input type="color" value="{{form.body.color2}}" data-color-for="body.color2" aria-label="{{localize "DICER.Appearance.Body.SecondColor"}}"><input type="text" name="body.color2" value="{{form.body.color2}}" maxlength="7" spellcheck="false" aria-label="{{localize "DICER.Appearance.Body.SecondColor"}}"></span></div>{{else}}<label class="dicer-field dicer-ae-range"><span>{{localize "DICER.Appearance.Body.Roughness"}}<output data-for="body.roughness">{{pct.roughness}}</output></span><input type="range" name="body.roughness" min="0" max="1" step="0.01" value="{{form.body.roughness}}"></label>{{/if}}
          </div>
          {{#if show.finish}}
            <div class="dicer-field">
              <span>{{localize "DICER.Appearance.Body.Finish"}}</span>
              <div class="dicer-segmented dicer-ae-seg">
                {{#each finishes}}<button type="button" class="{{#if active}}active{{/if}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" data-action="setField" data-field="body.finish" data-value="{{id}}">{{label}}</button>{{/each}}
              </div>
            </div>
          {{/if}}
          {{#if show.color2}}<label class="dicer-field dicer-ae-range"><span>{{localize "DICER.Appearance.Body.Roughness"}}<output data-for="body.roughness">{{pct.roughness}}</output></span><input type="range" name="body.roughness" min="0" max="1" step="0.01" value="{{form.body.roughness}}"></label>{{/if}}
        </div>
      </details>

      <details class="dicer-ae-section" data-section="inside" {{#if open.inside}}open{{/if}}>
        <summary><i class="fa-solid fa-flask"></i> <span>{{localize "DICER.Appearance.Section.inside"}}</span><em>{{summary.inside}}</em></summary>
        <div class="dicer-ae-fields">
          {{#if show.inside}}
            <div class="dicer-field">
              <span>{{localize "DICER.Appearance.Inside.Type"}}</span>
              <div class="dicer-ae-chips" role="radiogroup" aria-label="{{localize "DICER.Appearance.Inside.Type"}}">
                {{#each insideTypes}}
                  <button type="button" class="dicer-ae-chip {{#if active}}active{{/if}}" role="radio" aria-checked="{{#if active}}true{{else}}false{{/if}}" data-action="setField" data-field="interior.type" data-value="{{id}}"><i class="fa-solid {{icon}}"></i><span>{{label}}</span></button>
                {{/each}}
              </div>
            </div>
            {{#if show.insideDetails}}
              <div class="dicer-ae-row">
                <div class="dicer-field dicer-ae-color"><span>{{localize "DICER.Appearance.Inside.MainColor"}}</span><span class="dicer-ae-color-pair"><input type="color" value="{{form.interior.color1}}" data-color-for="interior.color1" aria-label="{{localize "DICER.Appearance.Inside.MainColor"}}"><input type="text" name="interior.color1" value="{{form.interior.color1}}" maxlength="7" spellcheck="false" aria-label="{{localize "DICER.Appearance.Inside.MainColor"}}"></span></div>
                <div class="dicer-field dicer-ae-color"><span>{{localize "DICER.Appearance.Inside.SecondColor"}}</span><span class="dicer-ae-color-pair"><input type="color" value="{{form.interior.color2}}" data-color-for="interior.color2" aria-label="{{localize "DICER.Appearance.Inside.SecondColor"}}"><input type="text" name="interior.color2" value="{{form.interior.color2}}" maxlength="7" spellcheck="false" aria-label="{{localize "DICER.Appearance.Inside.SecondColor"}}"></span></div>
              </div>
              <label class="dicer-field dicer-ae-range"><span>{{localize "DICER.Appearance.Inside.Density"}}<output data-for="interior.density">{{pct.density}}</output></span><input type="range" name="interior.density" min="0" max="1" step="0.01" value="{{form.interior.density}}"></label>
              {{#if show.insideShape}}
                <div class="dicer-field">
                  <span>{{localize "DICER.Appearance.Inside.Shape"}}</span>
                  <div class="dicer-segmented dicer-ae-seg">
                    {{#each shapes}}<button type="button" class="{{#if active}}active{{/if}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" data-action="setField" data-field="interior.shape" data-value="{{id}}"><i class="fa-solid {{icon}}"></i> {{label}}</button>{{/each}}
                  </div>
                </div>
              {{/if}}
            {{/if}}
          {{else}}
            <p class="dicer-hint dicer-ae-note"><i class="fa-solid fa-circle-info"></i> {{localize "DICER.Appearance.Inside.ResinOnly"}}</p>
          {{/if}}
        </div>
      </details>

      <details class="dicer-ae-section" data-section="numbers" {{#if open.numbers}}open{{/if}}>
        <summary><i class="fa-solid fa-hashtag"></i> <span>{{localize "DICER.Appearance.Section.numbers"}}</span><em>{{summary.numbers}}</em></summary>
        <div class="dicer-ae-fields">
          <div class="dicer-field">
            <span>{{localize "DICER.Appearance.Numbers.Fill"}}</span>
            <div class="dicer-ae-chips" role="radiogroup" aria-label="{{localize "DICER.Appearance.Numbers.Fill"}}">
              {{#each fills}}
                <button type="button" class="dicer-ae-chip {{#if active}}active{{/if}}" role="radio" aria-checked="{{#if active}}true{{else}}false{{/if}}" data-action="setField" data-field="numbers.fill" data-value="{{id}}">
                  <span class="dicer-ae-swatch dicer-ae-fill-{{id}}" style="--c: {{../form.numbers.color}}" aria-hidden="true"></span><span>{{label}}</span>
                </button>
              {{/each}}
            </div>
          </div>
          {{#if show.numberColor}}<div class="dicer-ae-row"><div class="dicer-field dicer-ae-color"><span>{{localize "DICER.Appearance.Numbers.Color"}}</span><span class="dicer-ae-color-pair"><input type="color" value="{{form.numbers.color}}" data-color-for="numbers.color" aria-label="{{localize "DICER.Appearance.Numbers.Color"}}"><input type="text" name="numbers.color" value="{{form.numbers.color}}" maxlength="7" spellcheck="false" aria-label="{{localize "DICER.Appearance.Numbers.Color"}}"></span></div><label class="dicer-field dicer-ae-range"><span>{{localize "DICER.Appearance.Numbers.Depth"}}<output data-for="numbers.depth">{{pct.depth}}</output></span><input type="range" name="numbers.depth" min="0" max="1" step="0.01" value="{{form.numbers.depth}}"></label></div>{{else}}<label class="dicer-field dicer-ae-range"><span>{{localize "DICER.Appearance.Numbers.Depth"}}<output data-for="numbers.depth">{{pct.depth}}</output></span><input type="range" name="numbers.depth" min="0" max="1" step="0.01" value="{{form.numbers.depth}}"></label>{{/if}}
          <div class="dicer-field">
            <span>{{localize "DICER.Appearance.Numbers.Relief"}}</span>
            <div class="dicer-segmented dicer-ae-seg">
              {{#each reliefs}}<button type="button" class="{{#if active}}active{{/if}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" data-action="setField" data-field="numbers.relief" data-value="{{id}}">{{label}}</button>{{/each}}
            </div>
          </div>
          <div class="dicer-field">
            <span>{{localize "DICER.Appearance.Numbers.CritIcon"}}</span>
            <div class="dicer-ae-chips" role="radiogroup" aria-label="{{localize "DICER.Appearance.Numbers.CritIcon"}}">
              {{#each critIcons}}<button type="button" class="dicer-ae-chip {{#if active}}active{{/if}}" role="radio" aria-checked="{{#if active}}true{{else}}false{{/if}}" data-action="setField" data-field="numbers.critIcon" data-value="{{id}}">{{label}}</button>{{/each}}
            </div>
          </div>
          <div class="dicer-field">
            <span>{{localize "DICER.Appearance.Numbers.FumbleIcon"}}</span>
            <div class="dicer-ae-chips" role="radiogroup" aria-label="{{localize "DICER.Appearance.Numbers.FumbleIcon"}}">
              {{#each fumbleIcons}}<button type="button" class="dicer-ae-chip {{#if active}}active{{/if}}" role="radio" aria-checked="{{#if active}}true{{else}}false{{/if}}" data-action="setField" data-field="numbers.fumbleIcon" data-value="{{id}}">{{label}}</button>{{/each}}
            </div>
            <p class="dicer-hint">{{localize "DICER.Appearance.Numbers.IconsHint"}}</p>
          </div>
          <div class="dicer-field">
            <span>{{localize "DICER.Appearance.Numbers.Font"}}</span>
            <div class="dicer-ae-chips" role="radiogroup" aria-label="{{localize "DICER.Appearance.Numbers.Font"}}">
              {{#each fontKinds}}<button type="button" class="dicer-ae-chip {{#if active}}active{{/if}} dicer-ae-font-{{id}}" role="radio" aria-checked="{{#if active}}true{{else}}false{{/if}}" data-action="setField" data-field="numbers.fontKind" data-value="{{id}}">{{label}}</button>{{/each}}
            </div>
          </div>
          {{#if show.fontFamily}}
            <label class="dicer-field">
              <span>{{localize "DICER.Appearance.Numbers.Family"}}</span>
              <input type="text" name="numbers.fontFamily" value="{{form.numbers.fontFamily}}" list="dicer-ae-fonts" placeholder="{{localize "DICER.Appearance.Numbers.FamilyPlaceholder"}}" spellcheck="false" autocomplete="off">
              <datalist id="dicer-ae-fonts">{{#each fontSuggestions}}<option value="{{this}}"></option>{{/each}}</datalist>
            </label>
            <div class="dicer-ae-suggest">{{#each fontSuggestions}}<button type="button" class="dicer-ae-pill" data-action="setField" data-field="numbers.fontFamily" data-value="{{this}}" style="font-family: '{{this}}'">{{this}}</button>{{/each}}</div>
          {{/if}}
          {{#if show.fontFile}}
            <div class="dicer-field">
              <span>{{localize "DICER.Appearance.Numbers.File"}}</span>
              <div class="dicer-ae-inline">
                <input type="text" name="numbers.fontFile" value="{{form.numbers.fontFile}}" placeholder="fonts/my-font.ttf" spellcheck="false" autocomplete="off">
                {{#if canBrowse}}<button type="button" class="dicer-icon" data-action="pickFont" data-tooltip="DICER.Appearance.Numbers.Browse" aria-label="{{localize "DICER.Appearance.Numbers.Browse"}}"><i class="fa-solid fa-folder-open"></i></button>{{/if}}
              </div>
            </div>
          {{/if}}
          <p class="dicer-ae-font-msg" role="status" {{#unless fontMessage}}hidden{{/unless}}><i class="fa-solid fa-triangle-exclamation"></i> <span>{{fontMessage}}</span></p>
        </div>
      </details>

      <details class="dicer-ae-section" data-section="edges" {{#if open.edges}}open{{/if}}>
        <summary><i class="fa-regular fa-square"></i> <span>{{localize "DICER.Appearance.Section.edges"}}</span><em>{{summary.edges}}</em></summary>
        <div class="dicer-ae-fields">
          <div class="dicer-field">
            <span>{{localize "DICER.Appearance.Edges.Sharpness"}}</span>
            <div class="dicer-segmented dicer-ae-seg dicer-ae-edges">
              {{#each edgeSteps}}
                <button type="button" class="{{#if active}}active{{/if}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" data-action="setField" data-field="edges.radius" data-value="{{value}}" data-tooltip="{{label}}" aria-label="{{label}}">
                  <span class="dicer-ae-edge" style="--r: {{radius}}px" aria-hidden="true"></span>
                </button>
              {{/each}}
            </div>
            <div class="dicer-ae-scale"><span>{{localize "DICER.Appearance.Edge.sharp"}}</span><span>{{localize "DICER.Appearance.Edge.veryRound"}}</span></div>
          </div>
        </div>
      </details>

      <details class="dicer-ae-section" data-section="glow" {{#if open.glow}}open{{/if}}>
        <summary><i class="fa-solid fa-sun"></i> <span>{{localize "DICER.Appearance.Section.glow"}}</span><em>{{summary.glow}}</em></summary>
        <div class="dicer-ae-fields">
          <div class="dicer-ae-row"><div class="dicer-field dicer-ae-color"><span>{{localize "DICER.Appearance.Glow.Color"}}</span><span class="dicer-ae-color-pair"><input type="color" value="{{form.glow.color}}" data-color-for="glow.color" aria-label="{{localize "DICER.Appearance.Glow.Color"}}"><input type="text" name="glow.color" value="{{form.glow.color}}" maxlength="7" spellcheck="false" aria-label="{{localize "DICER.Appearance.Glow.Color"}}"></span></div><label class="dicer-field dicer-ae-range"><span>{{localize "DICER.Appearance.Glow.Intensity"}}<output data-for="glow.intensity">{{pct.intensity}}</output></span><input type="range" name="glow.intensity" min="0" max="2" step="0.05" value="{{form.glow.intensity}}"></label></div>
          
        </div>
      </details>

      <details class="dicer-ae-section" data-section="perType" {{#if open.perType}}open{{/if}}>
        <summary><i class="fa-solid fa-dice"></i> <span>{{localize "DICER.Appearance.Section.perType"}}</span><em>{{summary.perType}}</em></summary>
        <div class="dicer-ae-fields">
          <p class="dicer-hint">{{localize "DICER.Appearance.PerType.Hint"}}</p>
          {{#if overrides.length}}
            <ul class="dicer-chips dicer-ae-overrides">
              {{#each overrides}}
                <li class="dicer-chip {{#if editing}}is-default{{/if}}">
                  <button type="button" class="dicer-ae-chip-link" data-action="editType" data-type="{{type}}" data-tooltip="DICER.Appearance.PerType.Edit">{{type}}</button>
                  <button type="button" class="dicer-chip-x" data-action="sameAsDefault" data-type="{{type}}" data-tooltip="DICER.Appearance.PerType.SameAsDefault" aria-label="{{localize "DICER.Appearance.PerType.SameAsDefault"}} ({{type}})"><i class="fa-solid fa-xmark"></i></button>
                </li>
              {{/each}}
            </ul>
          {{/if}}
          {{#if available.length}}
            <div class="dicer-field">
              <span>{{localize "DICER.Appearance.PerType.UseFor"}}</span>
              <div class="dicer-segmented dicer-ae-seg">
                {{#each available}}<button type="button" data-action="editType" data-type="{{this}}">{{this}}</button>{{/each}}
              </div>
            </div>
          {{/if}}
          {{#if isOverride}}
            <button type="button" class="dicer-ae-same" data-action="sameAsDefault" data-type="{{editing}}"><i class="fa-solid fa-rotate-left"></i> {{localize "DICER.Appearance.PerType.SameAsDefault"}}</button>
          {{/if}}
        </div>
      </details>

      <details class="dicer-ae-section" data-section="extras" {{#if open.extras}}open{{/if}}>
        <summary><i class="fa-solid fa-music"></i> <span>{{localize "DICER.Appearance.Section.extras"}}</span><em>{{summary.extras}}</em></summary>
        <div class="dicer-ae-fields">
          <label class="dicer-field">
            <span>{{localize "DICER.Appearance.Extras.SoundMaterial"}}</span>
            <select name="extras.soundMaterial">{{selectOptions materialChoices selected=extras.soundMaterial}}</select>
          </label>
          {{#each celebrations}}
            <div class="dicer-ae-row">
              <label class="dicer-field">
                <span>{{label}} · {{localize "DICER.Appearance.Extras.Effect"}}</span>
                <select name="extras.{{key}}.effect">{{selectOptions ../effectChoices selected=effect}}</select>
              </label>
              <label class="dicer-field">
                <span>{{label}} · {{localize "DICER.Appearance.Extras.Sound"}}</span>
                <select name="extras.{{key}}.sound">{{selectOptions ../soundChoices selected=sound}}</select>
              </label>
            </div>
          {{/each}}
        </div>
      </details>
    </div>
  </div>

  <footer class="dicer-footer dicer-ae-footer">
    <label class="dicer-field dicer-ae-name">
      <span>{{localize "DICER.Appearance.Name"}}</span>
      <input type="text" name="name" value="{{name}}" placeholder="{{localize "DICER.Appearance.NamePlaceholder"}}">
    </label>
    <div class="dicer-ae-actions">
      <button type="button" data-action="cancel"><i class="fa-solid fa-xmark"></i> {{localize "DICER.Appearance.Cancel"}}</button>
      {{#if isGM}}<button type="button" data-action="saveWorld" data-tooltip="DICER.Appearance.SaveWorldHint"><i class="fa-solid fa-globe"></i> {{localize "DICER.Appearance.SaveWorld"}}</button>{{/if}}
      <button type="button" class="{{#unless canUpdate}}bright{{/unless}}" data-action="saveMine"><i class="fa-solid fa-floppy-disk"></i> {{localize "DICER.Appearance.SaveMine"}}</button>
      {{#if canUpdate}}<button type="button" class="bright" data-action="update"><i class="fa-solid fa-check"></i> {{localize "DICER.Appearance.Update"}}</button>{{/if}}
    </div>
  </footer>
</div>
