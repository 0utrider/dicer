{{#if editing}}
  <form class="dicer-theme-edit">
    <p class="notes">{{localize "DICER.Themes.EditHint"}}</p>
    <div class="dicer-row">
      <label class="dicer-grow">{{localize "DICER.Themes.Name"}}
        <input type="text" name="name" value="{{edit.name}}">
      </label>
      <label>{{localize "DICER.Themes.BaseLook"}}
        <select name="base">{{selectOptions lookChoices selected=edit.base}}</select>
      </label>
      <label>{{localize "DICER.Themes.SoundMaterial"}}
        <select name="soundMaterial">{{selectOptions materialChoices selected=edit.soundMaterial}}</select>
      </label>
    </div>
    <fieldset>
      <legend>{{localize "DICER.Themes.PerType"}}</legend>
      <div class="dicer-row">
        {{#each dieRows}}
          <label>{{label}}
            <select name="perType.{{type}}">{{selectOptions ../perTypeChoices selected=value}}</select>
          </label>
        {{/each}}
      </div>
    </fieldset>
    {{#each celebrations}}
      <fieldset>
        <legend>{{label}}</legend>
        <div class="dicer-row">
          <label>{{localize "DICER.Themes.Effect"}}
            <select name="{{key}}.effect">{{selectOptions ../effectChoices selected=effect}}</select>
          </label>
          <label>{{localize "DICER.Themes.Sound"}}
            <select name="{{key}}.sound">{{selectOptions ../soundChoices selected=sound}}</select>
          </label>
        </div>
      </fieldset>
    {{/each}}
    <footer class="form-footer">
      <button type="button" data-action="saveEdit"><i class="fa-solid fa-floppy-disk"></i> {{localize "DICER.Themes.Save"}}</button>
      <button type="button" data-action="cancelEdit"><i class="fa-solid fa-xmark"></i> {{localize "DICER.Themes.Cancel"}}</button>
    </footer>
  </form>
{{else}}
  <div class="dicer-theme-toolbar">
    <label>{{localize "DICER.Themes.Filter"}}
      <select class="dicer-theme-filter">{{selectOptions filterChoices selected=filter}}</select>
    </label>
    <button type="button" data-action="importThemes"><i class="fa-solid fa-file-import"></i> {{localize "DICER.Themes.Import"}}</button>
    <button type="button" data-action="exportMine"><i class="fa-solid fa-file-export"></i> {{localize "DICER.Themes.ExportMine"}}</button>
    <input type="file" class="dicer-theme-file" accept=".json,application/json" hidden>
  </div>

  <div class="dicer-theme-grid">
    {{#each cards}}
      <section class="dicer-theme-card" data-theme="{{id}}">
        <div class="dicer-swatch" style="background: {{swatch}}">
          <img class="dicer-thumb" alt="{{name}}" hidden>
        </div>
        <header>
          <strong>{{name}}</strong>
          <span class="dicer-badge dicer-badge-{{source}}">{{sourceLabel}}</span>
        </header>
        <div class="dicer-row">
          <button type="button" data-action="useDefault" data-theme="{{id}}"><i class="fa-solid fa-star"></i> {{localize "DICER.Themes.UseDefault"}}</button>
        </div>
        <div class="dicer-row">
          <select class="dicer-target" aria-label="{{localize "DICER.Themes.UseFor"}}">
            {{#each ../targetGroups}}
              <optgroup label="{{label}}">
                {{#each options}}<option value="{{value}}">{{label}}</option>{{/each}}
              </optgroup>
            {{/each}}
          </select>
          <button type="button" data-action="apply" data-theme="{{id}}">{{localize "DICER.Themes.Use"}}</button>
          <button type="button" data-action="clear" data-theme="{{id}}">{{localize "DICER.Themes.Clear"}}</button>
        </div>
        <div class="dicer-row dicer-card-actions">
          <button type="button" data-action="duplicate" data-theme="{{id}}" data-tooltip="DICER.Themes.Duplicate"><i class="fa-solid fa-clone"></i></button>
          {{#if canEdit}}<button type="button" data-action="edit" data-theme="{{id}}" data-tooltip="DICER.Themes.Edit"><i class="fa-solid fa-pen"></i></button>{{/if}}
          <button type="button" data-action="exportOne" data-theme="{{id}}" data-tooltip="DICER.Themes.Export"><i class="fa-solid fa-download"></i></button>
          {{#if canPublish}}<button type="button" data-action="publish" data-theme="{{id}}" data-tooltip="DICER.Themes.Publish"><i class="fa-solid fa-globe"></i></button>{{/if}}
          {{#if canDelete}}<button type="button" data-action="remove" data-theme="{{id}}" data-tooltip="DICER.Themes.Delete"><i class="fa-solid fa-trash"></i></button>{{/if}}
        </div>
      </section>
    {{/each}}
  </div>

  {{#if unreadable.length}}
    <p class="notes">{{localize "DICER.Themes.Unreadable"}}</p>
    <ul class="dicer-unreadable">
      {{#each unreadable}}<li>{{label}} ({{sourceLabel}})</li>{{/each}}
    </ul>
  {{/if}}
{{/if}}
